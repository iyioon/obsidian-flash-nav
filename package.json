{
  "name": "obsidian-flash-nav",
  "version": "0.2.4",
  "description": "Flash-style navigation plugin for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.30.1",
    "@replit/codemirror-vim": "6.3.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^20.19.43",
    "esbuild": "0.25.5",
    "eslint": "^9.21.0",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "14.0.0",
    "jiti": "2.6.1",
    "jsdom": "26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
